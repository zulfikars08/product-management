@{
    ViewData["Title"] = "Products";
}

<div id="message" class="alert d-none" role="status" aria-live="polite"></div>

<section id="authPanel" class="auth-shell mx-auto">
    <div class="mb-4">
        <p class="eyebrow mb-2">Secure workspace</p>
        <h1 class="h2 mb-2">Manage your products</h1>
        <p class="text-secondary mb-0">Sign in or create an account to continue.</p>
    </div>

    <ul class="nav nav-tabs mb-4" role="tablist">
        <li class="nav-item" role="presentation"><button class="nav-link active" data-bs-toggle="tab" data-bs-target="#loginPane" type="button">Sign in</button></li>
        <li class="nav-item" role="presentation"><button class="nav-link" data-bs-toggle="tab" data-bs-target="#registerPane" type="button">Register</button></li>
    </ul>

    <div class="tab-content">
        <div id="loginPane" class="tab-pane fade show active">
            <form id="loginForm">
                <div class="mb-3"><label class="form-label" for="loginEmail">Email</label><input class="form-control" id="loginEmail" type="email" maxlength="254" autocomplete="email" required /></div>
                <div class="mb-4"><label class="form-label" for="loginPassword">Password</label><input class="form-control" id="loginPassword" type="password" maxlength="128" autocomplete="current-password" required /></div>
                <button class="btn btn-dark w-100" type="submit">Sign in</button>
            </form>
        </div>
        <div id="registerPane" class="tab-pane fade">
            <form id="registerForm">
                <div class="mb-3"><label class="form-label" for="registerEmail">Email</label><input class="form-control" id="registerEmail" type="email" maxlength="254" autocomplete="email" required /></div>
                <div class="mb-4"><label class="form-label" for="registerPassword">Password</label><input class="form-control" id="registerPassword" type="password" minlength="8" maxlength="128" autocomplete="new-password" required /><div class="form-text">Minimum 8 characters.</div></div>
                <button class="btn btn-dark w-100" type="submit">Create account</button>
            </form>
        </div>
    </div>
</section>

<section id="productPanel" class="d-none">
    <div class="d-flex flex-wrap align-items-start justify-content-between gap-3 mb-4">
        <div><p class="eyebrow mb-2">Catalog</p><h1 class="h2 mb-1">Products</h1><p class="text-secondary mb-0">Signed in as <span id="userEmail"></span></p></div>
        <div class="d-flex gap-2"><button id="addProductButton" class="btn btn-dark" type="button">Add product</button><button id="logoutButton" class="btn btn-outline-secondary" type="button">Logout</button></div>
    </div>

    <form id="filterForm" class="card card-body border-0 shadow-sm mb-4">
        <div class="row g-3 align-items-end">
            <div class="col-lg-6"><label class="form-label" for="filterName">Search name</label><input id="filterName" class="form-control" maxlength="200" placeholder="e.g. phone" /></div>
            <div class="col-sm-4 col-lg-2"><label class="form-label" for="minPrice">Minimum price</label><input id="minPrice" class="form-control" type="number" min="0" step="0.01" /></div>
            <div class="col-sm-4 col-lg-2"><label class="form-label" for="maxPrice">Maximum price</label><input id="maxPrice" class="form-control" type="number" min="0" step="0.01" /></div>
            <div class="col-sm-4 col-lg-2 d-grid gap-2"><button class="btn btn-outline-dark" type="submit">Apply</button><button id="clearFiltersButton" class="btn btn-link text-secondary p-0" type="button">Clear</button></div>
        </div>
    </form>

    <div id="loadingState" class="text-secondary py-5 text-center d-none">Loading products…</div>
    <div id="emptyState" class="empty-state d-none"><h2 class="h5">No products found</h2><p class="text-secondary mb-3">Add a product or clear your filters.</p><button id="emptyAddButton" class="btn btn-dark" type="button">Add product</button></div>
    <div id="productTable" class="table-responsive card border-0 shadow-sm d-none">
        <table class="table align-middle mb-0"><thead><tr><th>Name</th><th>Description</th><th>Price</th><th>Created</th><th class="text-end">Actions</th></tr></thead><tbody id="productRows"></tbody></table>
    </div>
</section>

<div class="modal fade" id="productModal" tabindex="-1" aria-labelledby="productModalTitle" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered"><div class="modal-content">
        <form id="productForm">
            <div class="modal-header"><h2 class="modal-title fs-5" id="productModalTitle">Add product</h2><button class="btn-close" type="button" data-bs-dismiss="modal" aria-label="Close"></button></div>
            <div class="modal-body">
                <div class="mb-3"><label class="form-label" for="productName">Name</label><input id="productName" class="form-control" maxlength="200" required /></div>
                <div class="mb-3"><label class="form-label" for="productDescription">Description</label><textarea id="productDescription" class="form-control" rows="4" maxlength="2000" required></textarea></div>
                <div><label class="form-label" for="productPrice">Price</label><input id="productPrice" class="form-control" type="number" min="0.01" step="0.01" required /></div>
            </div>
            <div class="modal-footer"><button class="btn btn-outline-secondary" type="button" data-bs-dismiss="modal">Cancel</button><button id="saveProductButton" class="btn btn-dark" type="submit">Save product</button></div>
        </form>
    </div></div>
</div>

@section Scripts {
    <script src="~/js/product-management.js" asp-append-version="true"></script>
}
