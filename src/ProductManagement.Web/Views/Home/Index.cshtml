@{
    ViewData["Title"] = "Products";
}

<section id="authPanel" class="auth-workspace">
    <div class="auth-intro">
        <div>
            <p class="eyebrow">Catalog workspace</p>
            <h1>Keep product records clear and current.</h1>
            <p class="auth-copy">A focused workspace for creating, reviewing, and maintaining your product catalog.</p>
        </div>
        <div class="workspace-motif" aria-hidden="true">
            <span class="motif-label">Product record</span>
            <span class="motif-line motif-line-wide"></span><span class="motif-line"></span>
            <div class="motif-grid"><span></span><span></span><span></span></div>
        </div>
        <ul class="auth-points">
            <li>Protected API access</li><li>Search and price filters</li><li>Portable local data</li>
        </ul>
    </div>

    <div class="auth-form-panel">
        <div class="auth-form-heading"><p class="eyebrow">Account access</p><h2>Welcome</h2><p>Sign in or create an account to continue.</p></div>
        <ul class="auth-tabs nav" role="tablist">
            <li class="nav-item" role="presentation"><button class="nav-link active" data-bs-toggle="tab" data-bs-target="#loginPane" type="button" role="tab">Sign in</button></li>
            <li class="nav-item" role="presentation"><button class="nav-link" data-bs-toggle="tab" data-bs-target="#registerPane" type="button" role="tab">Register</button></li>
        </ul>
        <div class="tab-content">
            <div id="loginPane" class="tab-pane fade show active" role="tabpanel">
                <form id="loginForm">
                    <div class="field-group"><label class="form-label" for="loginEmail">Email</label><input class="form-control" id="loginEmail" type="email" maxlength="254" autocomplete="email" required /></div>
                    <div class="field-group"><label class="form-label" for="loginPassword">Password</label><div class="password-field"><input class="form-control" id="loginPassword" type="password" maxlength="128" autocomplete="current-password" required /><button class="password-toggle" type="button" data-password-toggle="loginPassword" aria-label="Show password" aria-pressed="false"><svg class="icon-eye" aria-hidden="true"><use href="#eyeIcon"></use></svg><svg class="icon-eye-off" aria-hidden="true"><use href="#eyeOffIcon"></use></svg></button></div></div>
                    <button id="loginSubmitButton" class="btn btn-primary-action w-100" type="submit">Sign in</button>
                </form>
            </div>
            <div id="registerPane" class="tab-pane fade" role="tabpanel">
                <form id="registerForm">
                    <div class="field-group"><label class="form-label" for="registerEmail">Email</label><input class="form-control" id="registerEmail" type="email" maxlength="254" autocomplete="email" required /></div>
                    <div class="field-group"><label class="form-label" for="registerPassword">Password</label><div class="password-field"><input class="form-control" id="registerPassword" type="password" minlength="8" maxlength="128" autocomplete="new-password" required /><button class="password-toggle" type="button" data-password-toggle="registerPassword" aria-label="Show password" aria-pressed="false"><svg class="icon-eye" aria-hidden="true"><use href="#eyeIcon"></use></svg><svg class="icon-eye-off" aria-hidden="true"><use href="#eyeOffIcon"></use></svg></button></div><div class="form-text">Use 8–128 characters.</div></div>
                    <button id="registerSubmitButton" class="btn btn-primary-action w-100" type="submit">Create account</button>
                </form>
            </div>
        </div>
    </div>
</section>

<section id="productPanel" class="product-workspace d-none">
    <header class="workspace-header">
        <div><p class="eyebrow">Catalog</p><h1>Products</h1><p class="workspace-summary">Maintain accurate product details and pricing.</p></div>
        <div class="workspace-actions"><div class="identity"><span class="identity-label">Signed in as</span><strong id="userEmail"></strong></div><button id="logoutButton" class="btn btn-quiet" type="button">Log out</button><button id="addProductButton" class="btn btn-primary-action" type="button">Add product</button></div>
    </header>

    <form id="filterForm" class="filter-toolbar">
        <div class="filter-search"><label class="form-label" for="filterName">Search products</label><div class="search-field"><svg aria-hidden="true"><use href="#searchIcon"></use></svg><input id="filterName" class="form-control" maxlength="200" placeholder="Product name" /></div></div>
        <div><label class="form-label" for="minPrice">Minimum price</label><input id="minPrice" class="form-control numeric-input" type="number" min="0" step="0.01" /></div>
        <div><label class="form-label" for="maxPrice">Maximum price</label><input id="maxPrice" class="form-control numeric-input" type="number" min="0" step="0.01" /></div>
        <div class="filter-actions"><button class="btn btn-secondary-action" type="submit">Apply</button><button id="clearFiltersButton" class="btn btn-quiet" type="button">Clear</button></div>
    </form>

    <div id="loadingState" class="loading-state d-none" role="status"><span class="loading-line"></span><span>Loading products</span></div>
    <div id="emptyState" class="empty-state d-none"><span class="empty-symbol" aria-hidden="true">+</span><h2>No products found</h2><p>Add a product or clear your current filters.</p><button id="emptyAddButton" class="btn btn-primary-action" type="button">Add product</button></div>
    <div id="productTable" class="product-table-shell d-none">
        <div class="table-responsive"><table class="table product-table align-middle mb-0"><thead><tr><th>Name</th><th>Description</th><th class="text-end">Price</th><th>Created</th><th class="text-end">Actions</th></tr></thead><tbody id="productRows"></tbody></table></div>
    </div>
</section>

<div class="modal fade" id="productModal" tabindex="-1" aria-labelledby="productModalTitle" aria-hidden="true"><div class="modal-dialog modal-dialog-centered"><div class="modal-content"><form id="productForm"><div class="modal-header"><div><p class="eyebrow mb-1">Product record</p><h2 class="modal-title" id="productModalTitle">Add product</h2></div><button class="btn-close" type="button" data-bs-dismiss="modal" aria-label="Close"></button></div><div class="modal-body"><div class="field-group"><label class="form-label" for="productName">Name</label><input id="productName" class="form-control" maxlength="200" required /></div><div class="field-group"><label class="form-label" for="productDescription">Description</label><textarea id="productDescription" class="form-control" rows="4" maxlength="2000" required></textarea></div><div><label class="form-label" for="productPrice">Price</label><input id="productPrice" class="form-control numeric-input" type="number" min="0.01" step="0.01" required /></div></div><div class="modal-footer"><button class="btn btn-quiet" type="button" data-bs-dismiss="modal">Cancel</button><button id="saveProductButton" class="btn btn-primary-action" type="submit">Save product</button></div></form></div></div></div>

<div class="modal fade" id="deleteModal" tabindex="-1" aria-labelledby="deleteModalTitle" aria-hidden="true"><div class="modal-dialog modal-dialog-centered modal-sm"><div class="modal-content"><div class="modal-header"><h2 class="modal-title" id="deleteModalTitle">Delete product?</h2><button class="btn-close" type="button" data-bs-dismiss="modal" aria-label="Close"></button></div><div class="modal-body"><p class="mb-0"><strong id="deleteProductName"></strong> will be permanently removed.</p></div><div class="modal-footer"><button class="btn btn-quiet" type="button" data-bs-dismiss="modal">Cancel</button><button id="confirmDeleteButton" class="btn btn-danger-action" type="button">Delete product</button></div></div></div></div>

<svg class="svg-definitions" aria-hidden="true"><symbol id="eyeIcon" viewBox="0 0 24 24"><path d="M2.5 12s3.5-6 9.5-6 9.5 6 9.5 6-3.5 6-9.5 6-9.5-6-9.5-6Z"/><circle cx="12" cy="12" r="2.75"/></symbol><symbol id="eyeOffIcon" viewBox="0 0 24 24"><path d="m3 3 18 18M10.6 6.15A10.8 10.8 0 0 1 12 6c6 0 9.5 6 9.5 6a15.4 15.4 0 0 1-2.13 2.75M6.26 7.26C3.82 9.03 2.5 12 2.5 12s3.5 6 9.5 6c1.25 0 2.38-.26 3.39-.68M9.85 9.85a3 3 0 0 0 4.3 4.3"/></symbol><symbol id="searchIcon" viewBox="0 0 24 24"><circle cx="11" cy="11" r="6.5"/><path d="m16 16 4 4"/></symbol></svg>

@section Scripts { <script src="~/js/product-management.js" asp-append-version="true"></script> }
